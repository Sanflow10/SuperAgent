# OLLAMA
OLLAMA_URL=http://127.0.0.1:11434
PLANNER_MODEL=qwen3:8b
RESEARCHER_MODEL=qwen3:8b
CODER_MODEL=qwen2.5-coder:7b
CRITIC_MODEL=qwen3:8b
PLANNER_TEMPERATURE=0.0
RESEARCHER_TEMPERATURE=0.2
CODER_TEMPERATURE=0.2
CRITIC_TEMPERATURE=0.0
LLM_TIMEOUT=300
LLM_RETRIES=3

# EXECUTION
MAX_STEPS=20
MAX_REPLANS=3
MAX_AGENT_DEPTH=3
MAX_RUNTIME_MINUTES=30
MAX_CONTEXT_CHARS=24000
MAX_READ_CHARS=8000
MAX_MEMORY_RECORDS=500

# TOOLS
ALLOW_FILE_READ=true
ALLOW_FILE_WRITE=true
ALLOW_NETWORK=false
ALLOW_SHELL=false

# SANDBOX (V0.6)
ALLOW_SANDBOX=false
SANDBOX_BACKEND=auto
SANDBOX_TIMEOUT=30
SANDBOX_MEMORY_MB=256
SANDBOX_MAX_OUTPUT=8000

# DECISION LAYER (V0.6)
# engine: llm (LLM classico) | rules (deterministico, offline) | typed (endpoint)
DECISION_ENGINE=llm
DECISION_MIN_CONFIDENCE=0.0
# Para DECISION_ENGINE=typed (Jev via gateway, Laya, classificador local):
DECISION_URL=
DECISION_MODEL=
DECISION_API_KEY=
DECISION_TIMEOUT=60

# APPLICATION
LOG_LEVEL=INFO
